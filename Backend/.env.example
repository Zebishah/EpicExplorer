# Required for email-based OTP and password-reset flows.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
BASE_URL=http://localhost:5000

# Required for Stripe payment flows.
STRIPE_SECRET_KEY=

PORT=5000
MONGOURI=mongodb://127.0.0.1:27017/epicexplorer
JWT_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-second-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Required for Stellar balance and payment flows on the configured network.
ADMIN_ACCOUNT_ID=
ADMIN_SECRET_SEED=

# Required for email-based OTP and password-reset flows.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=

# Used only by `npm run create:admin`; never expose this route publicly.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=SUPER_ADMIN

# Required for Stripe payment flows.
STRIPE_SECRET_KEY=
